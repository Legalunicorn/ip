<?xml version="1.0" encoding="UTF-8"?>

<!-- Adapted from the SE-EDU JavaFX Tutorial, Part 4:
     https://se-education.org/guides/tutorials/javaFxPart4.html -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="400.0" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bingus.ui.MainWindow">
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" hvalue="1.0" vvalue="1.0">
            <content>
                <VBox fx:id="dialogContainer" minWidth="0.0" />
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox minHeight="41.0">
            <children>
                <TextField fx:id="userInput" maxWidth="1.7976931348623157E308" onAction="#handleUserInput" promptText="Type here..." HBox.hgrow="ALWAYS" />
                <Button maxHeight="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleUserInput" prefWidth="76.0" text="Send" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
